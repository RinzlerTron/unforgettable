# Copy to .env and adjust. Every value has a safe default in src/config.py;
# the agent runs with zero keys when MEM_LLM=off and MEM_EMBEDDINGS=local.

# Comma-separated list of CockroachDB connection URLs. With more than one URL
# the client fails over to the next node when a connection dies (this is what
# the chaos demo exercises). For CockroachDB Cloud, paste the URL from the
# console or from tools/ccloud_deploy.sh output.
MEM_DB_URLS=postgresql://root@localhost:26257/unforgettable?sslmode=disable

# LLM backend: off | bedrock | anthropic
#   off       - deterministic scripted agent, no keys needed, full memory pipeline
#   bedrock   - Claude on AWS Bedrock via boto3 (uses AWS credentials/role)
#   anthropic - direct Anthropic API (needs ANTHROPIC_API_KEY)
MEM_LLM=off

# Embedding backend: local | bedrock
#   local   - pure-Python hashed term embeddings, no network, deterministic
#   bedrock - Amazon Titan Text Embeddings V2 (256 dimensions)
MEM_EMBEDDINGS=local

# Bedrock settings (only read when MEM_LLM=bedrock or MEM_EMBEDDINGS=bedrock)
AWS_REGION=us-east-1
MEM_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MEM_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Anthropic settings (only read when MEM_LLM=anthropic)
ANTHROPIC_API_KEY=
MEM_ANTHROPIC_MODEL=claude-opus-4-8

# Web UI bind address
MEM_WEB_HOST=127.0.0.1
MEM_WEB_PORT=8400
